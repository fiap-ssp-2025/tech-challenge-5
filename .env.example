# ── LLM geradora (qualquer endpoint compatível com OpenAI). Padrão: OpenRouter (pago por token, sem infra).
OPENROUTER_API_KEY=sk-or-...
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini
LLM_API_KEY=${OPENROUTER_API_KEY}
# Modelo rápido para a extração ao vivo (pode ser o mesmo da geradora)
FAST_BASE_URL=https://openrouter.ai/api/v1
FAST_MODEL=google/gemini-2.5-flash-lite
FAST_API_KEY=${OPENROUTER_API_KEY}
# Alternativa auto-hospedada (vLLM no RunPod, `make pod-create`):
# LLM_BASE_URL=https://<pod-id>-8000.proxy.runpod.net/v1  LLM_MODEL=QuantTrio/Qwen3.6-27B-AWQ  LLM_API_KEY=guardia-dev-key

# ── Fallback opcional da geradora (OpenAI)
OPENAI_API_KEY=
OPENAI_FALLBACK_MODEL=gpt-4o-mini

# ── Juiz independente: modelo de outra família (nunca o mesmo da geradora)
JUDGE_BASE_URL=https://openrouter.ai/api/v1
JUDGE_MODEL=mistralai/mistral-small-3.2-24b-instruct
JUDGE_API_KEY=${OPENROUTER_API_KEY}
# no pod: JUDGE_BASE_URL=https://<pod-id>-8001.proxy.runpod.net/v1  JUDGE_MODEL=Qwen/Qwen2.5-7B-Instruct-AWQ

# ── Hugging Face (publicação dos modelos na org)
HF_TOKEN=
HF_ORG=fiap-ssp-2025

# ── RunPod (scripts/runpod_vllm.py)
RUNPOD_API_KEY=
RUNPOD_GPU_TYPE="NVIDIA A40"

# ── LangSmith (opcional; rastreia cada nó do grafo)
LANGCHAIN_TRACING_V2=false
LANGSMITH_API_KEY=
LANGCHAIN_PROJECT=guardia-ai

# ── App
GUARDIA_DB_PATH=data/generated/audit.db
GUARDIA_MODEL_PATH=models/encaminhamento_rf.joblib
