# ── LLM geradora (endpoint compatível com OpenAI; vLLM no RunPod, Ollama local, etc.)
LLM_BASE_URL=https://<pod-id>-8000.proxy.runpod.net/v1
LLM_MODEL=QuantTrio/Qwen3.6-27B-AWQ
LLM_API_KEY=troque-por-uma-chave

# ── Fallback opcional da geradora (OpenAI)
OPENAI_API_KEY=
OPENAI_FALLBACK_MODEL=gpt-4o-mini

# ── Juiz independente (provedor diferente da geradora). Padrão: Hugging Face Inference Router
JUDGE_BASE_URL=https://router.huggingface.co/v1
JUDGE_MODEL=Qwen/Qwen2.5-7B-Instruct
JUDGE_API_KEY=${HF_TOKEN}

# ── Hugging Face (publicação dos modelos na org)
HF_TOKEN=
HF_ORG=fiap-ssp-2025

# ── RunPod (scripts/runpod_vllm.py)
RUNPOD_API_KEY=
RUNPOD_GPU_TYPE="NVIDIA A40"

# ── LangSmith (opcional; rastreia cada nó do grafo)
LANGCHAIN_TRACING_V2=false
LANGSMITH_API_KEY=
LANGCHAIN_PROJECT=guardia-ai

# ── App
GUARDIA_DB_PATH=data/generated/audit.db
GUARDIA_MODEL_PATH=models/encaminhamento_rf.joblib
